# ── Modal (optional: runs the GPU clipping pipeline in the cloud) ──
# Get token at https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Gemini (free key: https://aistudio.google.com/apikey) ──
# Used for picking the best moments, titles and Hinglish spelling.
# Optional: without a key the app still works with built-in scoring.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── Speech to text ──
# Which Whisper model to use when transcribing locally:
#   large-v3-turbo (default, fast, 6GB VRAM, good Hinglish)
#   large-v3 (slower, ~10GB VRAM, best accuracy for pure Hindi)
#   base (tiny, fast, CPU friendly, low accuracy on accents)
WHISPER_MODEL=large-v3-turbo

# ── Performance ──
# Set to 1 to enable verbose per-stage time logging:
TIMING=0
