# Viral Clipper By MrBitBlox - settings
# Setup copies this file to backend/.env. Edit .env, never this example.
# Restart the app after changing .env.

# ── Gemini (free key: https://aistudio.google.com/apikey) ──
# Used for picking the best moments, titles and Hinglish spelling.
# Optional: without a key the app still works with built-in scoring.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ── Speech to text ──
# auto = large-v3-turbo on an NVIDIA GPU, small on CPU
WHISPER_MODEL=auto
# auto | cuda | cpu   (use cpu if GPU transcription errors)
WHISPER_DEVICE=auto
# Spoken language: auto (detects Hinglish / English), or force hi / en
TRANSCRIBE_LANGUAGE=auto
# roman = Hinglish in English letters | native = Hindi in Devanagari
CAPTION_SCRIPT=roman

# ── Video ──
# auto = NVIDIA NVENC if available, else CPU (libx264)
VIDEO_ENCODER=auto

# ── Caption look ──
# Styles: streamer (default), hormozi, beast, neon, boxed, karaoke, fire, meme, clean
DEFAULT_CAPTION_STYLE=streamer
CAPTION_SIZE_SCALE=1.0
# Vertical centre of captions (0 = top, 0.5 = middle, 1 = bottom)
CAPTION_Y_SPLIT=0.48
CAPTION_Y_DEFAULT=0.55
# Webcam band height in split-cam shorts (share of the frame)
SPLIT_CAM_TOP_FRACTION=0.40
# Burn the clip title (black label box) into the video: 1 = yes, 0 = no
TITLE_OVERLAY=1

# ── Clip quality filters ──
MIN_CLIP_SCORE=40
INTRO_SKIP_SEC=15
OUTRO_SKIP_SEC=20
